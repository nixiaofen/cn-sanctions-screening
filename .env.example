# 复制本文件为 .env 并填入真实密钥。不要将 .env 提交到 Git。

# Tavily：情报检索（可多 key 逗号分隔，配额轮换）
# 申请：https://tavily.com
TAVILY_API_KEYS=your_tavily_key_here
# 或单 key：
# TAVILY_API_KEY=your_tavily_key_here

# OpenSanctions：名单聚合初筛
# 申请：https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=your_opensanctions_api_key_here
